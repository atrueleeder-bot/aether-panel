{
  "name": "aether-panel",
  "version": "0.1.4",
  "private": true,
  "description": "A standalone Windows Minecraft control panel with local server builders and compatible mod discovery.",
  "main": "dist/main/index.js",
  "author": "Manus AI",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"pnpm:dev:renderer\" \"pnpm:dev:electron\"",
    "dev:renderer": "vite --host 0.0.0.0",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "vite build && tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "preview": "vite preview --host 0.0.0.0",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:portable": "npm run build && electron-builder --win portable --publish never",
    "dist:all": "npm run build && electron-builder --win nsis portable --publish never",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "io.aetherpanel.desktop",
    "productName": "Aether Panel",
    "artifactName": "Aether-Panel-${version}-${arch}.${ext}",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "generateUpdatesFilesForAllChannels": true,
    "publish": [
      {
        "provider": "github",
        "owner": "atrueleeder-bot",
        "repo": "aether-panel",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "Aether-Panel-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "electron-updater": "^6.8.9",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "typescript": "latest",
    "wait-on": "latest"
  }
}
